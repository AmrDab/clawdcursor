#!/usr/bin/env osascript -l JavaScript

/**
 * find-element.jxa
 *
 * Searches the UI tree for elements matching given criteria.
 *
 * Accepts both macOS/JXA arg names and Windows PS1 arg names so the same
 * TypeScript call site works on both platforms:
 *
 *   macOS args  ΓåÆ  Windows aliases
 *   -name           -Name
 *   -role           -ControlType  (with ControlTypeΓåÆrole mapping below)
 *   -processId      -ProcessId
 *
 * Returns JSON array of matches with:
 *   - name: Element name/label
 *   - role: macOS accessibility role (AXButton, AXTextField, ΓÇª)
 *   - bounds: {x, y, width, height}
 *   - processId: Owning process PID
 *   - value: Current value (if applicable)
 *
 * Usage: osascript -l JavaScript find-element.jxa -name "OK" -role "button" -processId 1234
 *   or:  osascript -l JavaScript find-element.jxa -ControlType Button -ProcessId 1234
 */

ObjC.import('stdlib');

// Map Windows UI Automation ControlType names ΓåÆ macOS AX role substrings
var CONTROL_TYPE_MAP = {
    'Button':      'AXButton',
    'Edit':        'AXTextField',
    'Document':    'AXWebArea',
    'ComboBox':    'AXComboBox',
    'CheckBox':    'AXCheckBox',
    'RadioButton': 'AXRadioButton',
    'Hyperlink':   'AXLink',
    'MenuItem':    'AXMenuItem',
    'Menu':        'AXMenu',
    'Tab':         'AXTabGroup',
    'TabItem':     'AXTab',
    'ListItem':    'AXCell',
    'TreeItem':    'AXOutlineRow',
    'Slider':      'AXSlider',
    'ScrollBar':   'AXScrollBar',
    'ToolBar':     'AXToolbar',
    'StaticText':  'AXStaticText',
    'Text':        'AXStaticText',
    'Window':      'AXWindow',
    'Group':       'AXGroup',
};

// Parse command line arguments ΓÇö accept both macOS and Windows PS1 naming
function parseArgs() {
    var args = ObjC.unwrap($.NSProcessInfo.processInfo.arguments);
    var result = { name: null, role: null, processId: null };

    for (var i = 0; i < args.length; i++) {
        var arg = ObjC.unwrap(args[i]);
        var next = i + 1 < args.length ? ObjC.unwrap(args[i + 1]) : null;

        if ((arg === '-name' || arg === '-Name') && next) {
            result.name = next;
        } else if (arg === '-role' && next) {
            result.role = next;
        } else if (arg === '-ControlType' && next) {
            // Translate Windows ControlType to macOS AX role
            result.role = CONTROL_TYPE_MAP[next] || ('AX' + next);
        } else if ((arg === '-processId' || arg === '-ProcessId') && next) {
            result.processId = parseInt(next, 10);
        }
        // -AutomationId has no macOS equivalent; silently ignore
    }

    return result;
}

function safeGet(obj, prop, def) {
    try { var v = obj[prop](); return (v !== undefined && v !== null) ? v : def; } catch (e) { return def; }
}

function getBounds(el) {
    try {
        var pos = el.position();
        var sz  = el.size();
        return { x: pos[0] || 0, y: pos[1] || 0, width: sz[0] || 0, height: sz[1] || 0 };
    } catch (e) {
        return { x: 0, y: 0, width: 0, height: 0 };
    }
}

// Normalise AX role spellings so 'AXTextField', 'text field' and 'TextField'
// compare equal (the ControlType map speaks one, System Events the other).
function normRole(r) { return String(r || '').toLowerCase().replace(/^ax/, '').replace(/\s+/g, ''); }

/**
 * Breadth-first search of a window. Each level's names, descriptions and
 * roles come back in ONE Apple Event per container (batched collection
 * reads), so controls nested in scroll areas, split views and toolbars are
 * reachable without the per-element round trips that made deep searches time
 * out. An element matches on its name (AXTitle) OR its description
 * (AXDescription — how AppKit exposes accessibilityLabel, e.g. on text fields).
 */
function collectMatches(win, targetName, targetRole, maxDepth, deadline) {
    var want = targetName ? String(targetName).toLowerCase() : null;
    var wantRole = targetRole ? normRole(targetRole) : null;
    var out = [];
    var level = [win];
    for (var d = 0; d < maxDepth && level.length && Date.now() < deadline; d++) {
        var next = [];
        for (var i = 0; i < level.length && Date.now() < deadline; i++) {
            var kids = level[i].uiElements;
            var names, descs, roles;
            try { names = kids.name(); } catch (e) { continue; }
            try { descs = kids.description(); } catch (e) { descs = []; }
            try { roles = kids.role(); } catch (e) { roles = []; }
            for (var k = 0; k < names.length; k++) {
                var el = kids[k];
                var nm = names[k] || '', ds = descs[k] || '', rl = roles[k] || '';
                var hay = [String(nm).toLowerCase(), String(ds).toLowerCase()];
                var nameOk = !want || hay[0].indexOf(want) !== -1 || hay[1].indexOf(want) !== -1;
                var roleOk = !wantRole || normRole(rl).indexOf(wantRole) !== -1;
                if (nameOk && roleOk && (nm || ds || rl)) {
                    out.push({ el: el, name: nm || ds, role: rl, exact: !!want && (hay[0] === want || hay[1] === want), depth: d });
                }
                next.push(el);
            }
        }
        level = next;
    }
    return out;
}

// Matches in a window: exact names first, then shallower elements.
function searchWindow(win, targetName, targetRole, maxResults, results, deadline) {
    var matches = collectMatches(win, targetName, targetRole, 12, deadline);
    matches.sort(function (x, y) { return (Number(y.exact) - Number(x.exact)) || (x.depth - y.depth); });
    for (var i = 0; i < matches.length && results.length < maxResults; i++) {
        var m = matches[i];
        var val = ''; try { val = m.el.value(); if (val === null || val === undefined) val = ''; } catch (e) {}
        results.push({ name: m.name, role: m.role, value: val, bounds: getBounds(m.el) });
    }
}

var output;
try {
    var params = parseArgs();
    var SystemEvents = Application('System Events');
    SystemEvents.includeStandardAdditions = true;

    var results = [];
    var maxResults = 20;
    var deadline = Date.now() + 6000;

    // Require processId OR name to avoid searching every window in every app
    if (!params.processId && !params.name) {
        output = JSON.stringify([]);
    } else {
        // Get target process(es)
        var targetProcesses;
        if (params.processId) {
            targetProcesses = SystemEvents.processes.where({ unixId: params.processId });
            if (targetProcesses.length === 0) {
                output = JSON.stringify({ error: 'No process found with ID ' + params.processId });
                $.exit(0);
            }
        } else {
            targetProcesses = SystemEvents.processes.where({ backgroundOnly: false });
        }

        // Search each process
        for (var p = 0; p < targetProcesses.length && results.length < maxResults; p++) {
            try {
                var proc = targetProcesses[p];
                var procId = safeGet(proc, 'unixId', 0);
                var beforeCount = results.length;

                var windows = proc.windows;
                for (var w = 0; w < windows.length && results.length < maxResults; w++) {
                    try {
                        searchWindow(windows[w], params.name, params.role, maxResults, results, deadline);
                    } catch (e) {}
                }

                // Stamp the processId on any newly-added results
                for (var r = beforeCount; r < results.length; r++) {
                    results[r].processId = procId;
                }
            } catch (e) {}
        }

        output = JSON.stringify(results, null, 0);
    }
} catch (error) {
    output = JSON.stringify({ error: error.toString() });
    $.exit(1);
}
output;

#!/usr/bin/env osascript -l JavaScript

/**
 * invoke-element.jxa
 * 
 * Finds a UI element and invokes an action on it.
 * 
 * Parameters:
 *   -action <string>     - Required. One of: click | focus | set-value | get-value |
 *                          expand | collapse | toggle | select
 *   -name <string>       - Match elements by name or description (contains match, case-insensitive)
 *   -role <string>       - Match elements by role (e.g., "button", "text field")
 *   -processId <number>  - Required. The process ID of the target application
 *   -value <string>      - Value to set (only used with set-value action)
 * 
 * Returns JSON result with success status and action-specific data.
 * 
 * Usage: osascript -l JavaScript invoke-element.jxa -action click -name "OK" -processId 1234
 *        osascript -l JavaScript invoke-element.jxa -action set-value -name "Username" -value "john" -processId 1234
 */

// Utility function to safely get property values
function safeGet(obj, property, defaultValue) {
    try {
        var val = obj[property]();
        return val !== undefined && val !== null ? val : defaultValue;
    } catch (e) {
        return defaultValue;
    }
}

// Normalise AX role spellings so 'AXTextField', 'text field' and 'TextField'
// compare equal (the ControlType map speaks one, System Events the other).
function normRole(r) { return String(r || '').toLowerCase().replace(/^ax/, '').replace(/\s+/g, ''); }

// Leaf controls: never descended (their children are decoration or a closed
// menu), so the walk only pays for real containers.
var LEAF = { button: 1, statictext: 1, textfield: 1, textarea: 1, checkbox: 1, radiobutton: 1,
             image: 1, slider: 1, valueindicator: 1, incrementor: 1, popupbutton: 1, menubutton: 1,
             scrollbar: 1, busyindicator: 1, progressindicator: 1, colorwell: 1, splitter: 1,
             disclosuretriangle: 1, searchfield: 1, combobox: 1 };

// Roles each action should land on, best first. set-value must reach the
// editable field, never the static label beside it that shares its name.
var ACTION_ROLES = {
    'set-value': ['textfield', 'textarea', 'combobox', 'searchfield'],
    'get-value': ['textfield', 'textarea', 'combobox', 'searchfield', 'statictext'],
    'toggle':    ['checkbox', 'radiobutton', 'switch'],
    'click':     ['button', 'menuitem', 'menubuttonitem', 'link', 'radiobutton', 'checkbox', 'popupbutton', 'cell', 'row', 'tab']
};

/**
 * Breadth-first search of a window. Each level's names, descriptions and
 * roles come back in ONE Apple Event per container (batched collection
 * reads), so controls nested in scroll areas, split views and toolbars are
 * reachable without the per-element round trips that made deep searches time
 * out. An element matches on its name (AXTitle) OR its description
 * (AXDescription — how AppKit exposes accessibilityLabel, e.g. on text fields).
 */
function collectMatches(win, targetName, targetRole, maxDepth, deadline) {
    var want = targetName ? String(targetName).toLowerCase() : null;
    var wantRole = targetRole ? normRole(targetRole) : null;
    var out = [];
    var level = [win];
    for (var d = 0; d < maxDepth && level.length && Date.now() < deadline; d++) {
        var next = [];
        for (var i = 0; i < level.length && Date.now() < deadline; i++) {
            var kids = level[i].uiElements;
            var names, descs, roles;
            try { names = kids.name(); } catch (e) { continue; }
            try { descs = kids.description(); } catch (e) { descs = []; }
            try { roles = kids.role(); } catch (e) { roles = []; }
            for (var k = 0; k < names.length; k++) {
                var el = kids[k];
                var nm = names[k] || '', ds = descs[k] || '', rl = roles[k] || '';
                var hay = [String(nm).toLowerCase(), String(ds).toLowerCase()];
                var nameOk = !want || hay[0].indexOf(want) !== -1 || hay[1].indexOf(want) !== -1;
                var roleOk = !wantRole || normRole(rl).indexOf(wantRole) !== -1;
                if (nameOk && roleOk && (nm || ds || rl)) {
                    out.push({ el: el, name: nm || ds, role: rl, exact: !!want && (hay[0] === want || hay[1] === want), depth: d });
                }
                if (!LEAF[normRole(rl)]) next.push(el);
            }
        }
        level = next;
    }
    return out;
}

// Exact name beats substring; then the role the action wants; then shallower.
function pickBest(matches, action) {
    var pref = ACTION_ROLES[action] || [];
    function score(m) {
        var rank = pref.indexOf(normRole(m.role));
        return (m.exact ? 0 : 1000) + (rank === -1 ? 100 : rank) * 10 + m.depth;
    }
    var best = null;
    for (var i = 0; i < matches.length; i++) {
        if (!best || score(matches[i]) < score(best)) best = matches[i];
    }
    return best;
}

// Get element bounds for coordinate fallback
function getElementBounds(element) {
    try {
        if (element.position && element.size) {
            var pos = element.position();
            var sz = element.size();
            return {
                x: pos[0] || 0,
                y: pos[1] || 0,
                width: sz[0] || 0,
                height: sz[1] || 0
            };
        }
    } catch (e) {}
    return null;
}

// run(argv) is the JXA entry point — osascript calls it and its return value becomes stdout.
// argv receives command-line arguments passed after the script path.
function run(argv) {
    try {
        // Parse arguments from argv array
        var params = { 
            action: null,
            name: null, 
            role: null, 
            processId: null,
            value: null
        };
        // Windows ControlType → macOS AX role mapping (mirrors find-element.jxa)
        var CONTROL_TYPE_MAP = {
            'Button': 'button', 'Edit': 'text field', 'Document': 'web area',
            'ComboBox': 'pop up button', 'CheckBox': 'checkbox',
            'RadioButton': 'radio button', 'Hyperlink': 'link',
            'MenuItem': 'menu item', 'Menu': 'menu', 'Tab': 'tab group',
            'TabItem': 'radio button', 'ListItem': 'row', 'TreeItem': 'row',
            'Slider': 'slider', 'ScrollBar': 'scroll bar',
            'ToolBar': 'toolbar', 'StaticText': 'static text', 'Window': 'window'
        };

        for (var i = 0; i < argv.length; i++) {
            var a = argv[i];
            var hasNext = i + 1 < argv.length;
            if ((a === '-action' || a === '-Action') && hasNext) {
                params.action = argv[++i];
            } else if ((a === '-name' || a === '-Name') && hasNext) {
                params.name = argv[++i];
            } else if ((a === '-role') && hasNext) {
                params.role = argv[++i];
            } else if (a === '-ControlType' && hasNext) {
                var ct = argv[++i];
                params.role = CONTROL_TYPE_MAP[ct] || ct.toLowerCase();
            } else if ((a === '-processId' || a === '-ProcessId' || a === '-FocusedProcessId') && hasNext) {
                // -FocusedProcessId accepted as an alias for callers that share
                // arg-building with get-screen-context.jxa (defense-in-depth).
                params.processId = parseInt(argv[++i], 10);
            } else if ((a === '-value' || a === '-Value') && hasNext) {
                params.value = argv[++i];
            }
            // -AutomationId and -Restore have no macOS equivalent; silently ignore
        }

        // Validate required parameters
        if (!params.action) {
            return JSON.stringify({ 
                success: false, 
                error: 'Missing required parameter: -action' 
            });
        }
        
        if (!params.processId) {
            return JSON.stringify({ 
                success: false, 
                error: 'Missing required parameter: -processId' 
            });
        }
        
        var SystemEvents = Application('System Events');
        SystemEvents.includeStandardAdditions = true;
        
        // Find the target process
        var targetProcess = null;
        var processes = SystemEvents.processes.where({ unixId: params.processId });
        
        if (processes.length === 0) {
            return JSON.stringify({ 
                success: false, 
                error: 'No process found with ID ' + params.processId 
            });
        }
        
        targetProcess = processes[0];
        
        // Find target element
        var targetElement = null;
        var windows = targetProcess.windows;
        
        var deadline = Date.now() + 6000;
        var matches = [];
        for (var w = 0; w < windows.length && Date.now() < deadline; w++) {
            matches = matches.concat(collectMatches(windows[w], params.name, params.role, 12, deadline));
        }
        var best = pickBest(matches, params.action);
        targetElement = best ? best.el : null;
        
        if (!targetElement) {
            var searchDesc = '';
            if (params.name) searchDesc += 'name="' + params.name + '" ';
            if (params.role) searchDesc += 'role="' + params.role + '" ';
            return JSON.stringify({ 
                success: false, 
                error: 'Element not found: ' + searchDesc.trim() 
            });
        }
        
        // Execute the requested action
        var result = { success: false };
        
        switch (params.action) {
            case 'click':
                try {
                    targetElement.click();
                    result = { 
                        success: true, 
                        action: 'click',
                        method: 'click()'
                    };
                } catch (e) {
                    // Fallback: return bounds for coordinate click
                    var bounds = getElementBounds(targetElement);
                    if (bounds) {
                        result = {
                            success: false,
                            action: 'click',
                            error: 'Element does not support click(). Use coordinate click.',
                            clickPoint: {
                                x: bounds.x + Math.floor(bounds.width / 2),
                                y: bounds.y + Math.floor(bounds.height / 2)
                            },
                            bounds: bounds
                        };
                    } else {
                        result = {
                            success: false,
                            action: 'click',
                            error: 'Click failed and no bounds available: ' + e.toString()
                        };
                    }
                }
                break;
                
            case 'set-value':
                if (params.value === null) {
                    result = {
                        success: false,
                        error: 'Value parameter required for set-value action'
                    };
                } else {
                    try {
                        targetElement.value = params.value;
                        result = {
                            success: true,
                            action: 'set-value',
                            value: params.value
                        };
                    } catch (e) {
                        // Try setting through focused property
                        try {
                            targetElement.focused = true;
                            // Use System Events to type the value
                            var app = Application.currentApplication();
                            app.includeStandardAdditions = true;
                            app.keystroke(params.value);
                            result = {
                                success: true,
                                action: 'set-value',
                                value: params.value,
                                method: 'keystroke'
                            };
                        } catch (ke) {
                            result = {
                                success: false,
                                error: 'Failed to set value: ' + e.toString()
                            };
                        }
                    }
                }
                break;
                
            case 'get-value':
                // Prefer AXValue, but fall back to the name property when AXValue
                // is absent OR empty. Some controls expose an AXValue that reads
                // "" while the real text is only in the title/name — returning the
                // empty string there caused false "value did not change" reads
                // (parity with the Windows ValuePattern→TextPattern fix).
                var gotVal = null, gotMethod = null;
                try {
                    var val = targetElement.value();
                    if (val !== null && val !== undefined && String(val).length > 0) {
                        gotVal = val; gotMethod = 'AXValue';
                    }
                } catch (e) { /* no AXValue — try name */ }
                if (gotVal === null) {
                    try {
                        var name = targetElement.name();
                        if (name !== null && name !== undefined && String(name).length > 0) {
                            gotVal = name; gotMethod = 'name';
                        }
                    } catch (ne) { /* no name either */ }
                }
                if (gotVal !== null) {
                    result = { success: true, action: 'get-value', value: gotVal, method: gotMethod };
                } else {
                    // Genuinely empty (e.g. an empty field) — report "" success, not an error.
                    result = { success: true, action: 'get-value', value: '', method: 'empty' };
                }
                break;
                
            case 'focus':
                try {
                    targetElement.focused = true;
                    result = {
                        success: true,
                        action: 'focus'
                    };
                } catch (e) {
                    result = {
                        success: false,
                        error: 'Failed to set focus: ' + e.toString()
                    };
                }
                break;

            // ── Tranche 1A: AX Expand/Collapse/Toggle/Select ────────────
            // macOS AX exposes these through attributes (`AXExpanded`,
            // `AXValue` for checkboxes) rather than actions. JXA lets us
            // set them directly. Failing gracefully when an element
            // doesn't support the attribute is important — UIA-style
            // pattern-query equivalents don't exist on AX, so we just
            // attempt the assignment and catch.
            case 'expand':
                try {
                    targetElement.attributes['AXExpanded'].value = true;
                    result = { success: true, action: 'expand' };
                } catch (e) {
                    try {
                        // Menu-style elements respond to AXShowMenu action.
                        targetElement.actions['AXShowMenu'].perform();
                        result = { success: true, action: 'expand', method: 'AXShowMenu' };
                    } catch (e2) {
                        result = {
                            success: false,
                            error: 'Element does not support expand (no AXExpanded attribute or AXShowMenu action)'
                        };
                    }
                }
                break;

            case 'collapse':
                try {
                    targetElement.attributes['AXExpanded'].value = false;
                    result = { success: true, action: 'collapse' };
                } catch (e) {
                    result = {
                        success: false,
                        error: 'Element does not support collapse (no AXExpanded attribute)'
                    };
                }
                break;

            case 'toggle':
                // Press it, as a user would — AXValue on checkboxes is usually
                // read-only — then read the real state back. The old code read
                // attributes['AXValue'].value WITHOUT calling it: that is an
                // object specifier, always truthy, so every toggle wrote 0 and
                // reported "Off" (live macOS run, 2026-10).
                try {
                    try { targetElement.actions['AXPress'].perform(); }
                    catch (pe) { targetElement.click(); }
                    var after = null;
                    try { after = targetElement.value(); } catch (ve) {}
                    result = {
                        success: true,
                        action: 'toggle',
                        method: 'AXPress',
                        data: { toggleState: (after === null || after === undefined) ? 'unknown' : (Number(after) ? 'On' : 'Off') }
                    };
                } catch (e) {
                    result = { success: false, error: 'Element does not support toggle (no AXPress): ' + e.toString() };
                }
                break;

            case 'select':
                // AX uses AXSelected attribute for list items / tabs.
                try {
                    targetElement.attributes['AXSelected'].value = true;
                    result = { success: true, action: 'select' };
                } catch (e) {
                    // Some pickers use AXPick / AXMenuItemMark attributes — try AXPress as last resort.
                    try {
                        targetElement.actions['AXPress'].perform();
                        result = { success: true, action: 'select', method: 'AXPress' };
                    } catch (e2) {
                        result = {
                            success: false,
                            error: 'Element does not support select (no AXSelected attribute or AXPress action)'
                        };
                    }
                }
                break;

            default:
                result = {
                    success: false,
                    error: 'Unknown action: ' + params.action
                };
        }
        
        return JSON.stringify(result);
        
    } catch (error) {
        return JSON.stringify({ success: false, error: error.toString() });
    }
}

{
  "app": "word",
  "name": "Microsoft Word",
  "kind": "desktop",
  "os": ["win32", "darwin"],
  "processNames": ["WINWORD", "Microsoft Word"],
  "shortcuts": {
    "new_document": { "default": "ctrl+n", "darwin": "" },
    "open_document": "mod+o",
    "save": "mod+s",
    "save_as": { "default": "F12", "darwin": "cmd+shift+s" },
    "close_document": { "default": "ctrl+w", "darwin": "cmd+F4" },
    "print": "mod+p",
    "print_preview": { "default": "ctrl+alt+i", "darwin": "" },
    "quit_word": { "default": "alt+F4", "darwin": "cmd+q" },
    "undo": "mod+z",
    "redo": "mod+y",
    "cut": "mod+x",
    "copy": "mod+c",
    "paste": "mod+v",
    "paste_text_only": "mod+shift+v",
    "paste_special": { "default": "", "darwin": "cmd+ctrl+v" },
    "copy_formatting": "mod+alt+c",
    "paste_formatting": "mod+alt+v",
    "select_all": "mod+a",
    "find": "mod+f",
    "replace": "ctrl+h",
    "go_to": { "default": "ctrl+g", "darwin": "cmd+alt+g" },
    "bold": "mod+b",
    "italic": "mod+i",
    "underline": "mod+u",
    "double_underline": "mod+shift+d",
    "underline_words_only": "mod+shift+w",
    "strikethrough": { "default": "", "darwin": "cmd+shift+x" },
    "small_caps": "mod+shift+k",
    "all_caps": "mod+shift+a",
    "cycle_letter_case": "shift+F3",
    "font_dialog": "mod+d",
    "increase_font_size": "mod+shift+>",
    "decrease_font_size": "mod+shift+<",
    "increase_font_size_one_point": "mod+]",
    "decrease_font_size_one_point": "mod+[",
    "clear_character_formatting": { "default": "ctrl+Space", "darwin": "" },
    "clear_paragraph_formatting": { "default": "ctrl+q", "darwin": "" },
    "align_center": "mod+e",
    "align_left": "mod+l",
    "align_right": "mod+r",
    "justify": "mod+j",
    "indent_paragraph": { "default": "ctrl+m", "darwin": "ctrl+shift+m" },
    "remove_paragraph_indent": { "default": "ctrl+shift+m", "darwin": "cmd+shift+m" },
    "hanging_indent": "mod+t",
    "remove_hanging_indent": "mod+shift+t",
    "single_line_spacing": "mod+1",
    "double_line_spacing": "mod+2",
    "one_and_half_line_spacing": "mod+5",
    "apply_normal_style": "mod+shift+n",
    "apply_heading_1": "mod+alt+1",
    "apply_heading_2": "mod+alt+2",
    "apply_heading_3": "mod+alt+3",
    "bulleted_list": "mod+shift+l",
    "apply_styles_pane": { "default": "ctrl+shift+s", "darwin": "" },
    "show_formatting_marks": { "default": "ctrl+shift+8", "darwin": "" },
    "insert_line_break": "shift+Return",
    "insert_page_break": "mod+Return",
    "insert_column_break": "mod+shift+Return",
    "insert_hyperlink": "mod+k",
    "insert_comment": { "default": "ctrl+alt+m", "darwin": "cmd+alt+a" },
    "insert_footnote": "mod+alt+f",
    "insert_endnote": { "default": "ctrl+alt+d", "darwin": "cmd+alt+e" },
    "toggle_track_changes": "mod+shift+e",
    "check_spelling_and_grammar": "F7",
    "thesaurus": "shift+F7",
    "word_left": { "default": "ctrl+Left", "darwin": "alt+Left" },
    "word_right": { "default": "ctrl+Right", "darwin": "alt+Right" },
    "paragraph_up": "mod+Up",
    "paragraph_down": "mod+Down",
    "line_start": "Home",
    "line_end": "End",
    "document_start": "mod+Home",
    "document_end": "mod+End",
    "next_page": "mod+PageDown",
    "previous_page": "mod+PageUp",
    "screen_down": "PageDown",
    "screen_up": "PageUp",
    "previous_edit_location": "shift+F5",
    "select_word_left": { "default": "ctrl+shift+Left", "darwin": "shift+alt+Left" },
    "select_word_right": { "default": "ctrl+shift+Right", "darwin": "shift+alt+Right" },
    "select_to_line_start": "shift+Home",
    "select_to_line_end": "shift+End",
    "select_to_paragraph_start": "mod+shift+Up",
    "select_to_paragraph_end": "mod+shift+Down",
    "select_to_document_start": "mod+shift+Home",
    "select_to_document_end": "mod+shift+End",
    "select_screen_up": "shift+PageUp",
    "select_screen_down": "shift+PageDown",
    "extend_selection_mode": "F8",
    "shrink_selection": "shift+F8",
    "delete_word_left": { "default": "ctrl+Backspace", "darwin": "" },
    "delete_word_right": { "default": "ctrl+Delete", "darwin": "" },
    "table_next_cell": "Tab",
    "table_previous_cell": "shift+Tab",
    "table_first_cell_in_row": { "default": "alt+Home", "darwin": "ctrl+Home" },
    "table_last_cell_in_row": { "default": "alt+End", "darwin": "ctrl+End" },
    "table_first_cell_in_column": { "default": "alt+PageUp", "darwin": "ctrl+PageUp" },
    "table_last_cell_in_column": { "default": "alt+PageDown", "darwin": "ctrl+PageDown" },
    "print_layout_view": { "default": "ctrl+alt+p", "darwin": "" },
    "outline_view": { "default": "ctrl+alt+o", "darwin": "" },
    "draft_view": { "default": "ctrl+alt+n", "darwin": "" },
    "zoom_in": "mod+Plus",
    "zoom_out": "mod+-",
    "zoom_100_percent": "mod+0",
    "context_menu": "shift+F10",
    "switch_pane": "F6",
    "toggle_ribbon": { "default": "ctrl+F1", "darwin": "cmd+alt+r" },
    "show_ribbon_key_tips": { "default": "alt", "darwin": "" },
    "ribbon_search_box": { "default": "alt q", "darwin": "" },
    "file_page": { "default": "alt f", "darwin": "" },
    "home_tab": { "default": "alt h", "darwin": "" },
    "insert_tab": { "default": "alt n", "darwin": "" },
    "design_tab": { "default": "alt g", "darwin": "" },
    "layout_tab": { "default": "alt p", "darwin": "" },
    "references_tab": { "default": "alt s", "darwin": "" },
    "review_tab": { "default": "alt r", "darwin": "" },
    "view_tab": { "default": "alt w", "darwin": "" },
    "cancel": "Escape"
  },
  "consequential": ["close_document", "quit_word"],
  "essentials": ["save", "document_end", "document_start", "go_to", "replace", "apply_heading_1", "apply_normal_style", "insert_page_break"],
  "workflows": {
    "find_text": {
      "name": "find text in the document",
      "steps": [
        { "type": "pressKey", "key": "mod+f", "note": "Navigation pane on Windows, search box on Mac" },
        { "type": "typeAtFocus", "field": "search text" },
        { "type": "pressKey", "key": "Return" }
      ]
    },
    "open_replace": {
      "name": "open find and replace",
      "steps": [
        { "type": "pressKey", "key": "ctrl+h", "note": "ctrl on Mac too" },
        { "type": "typeAtFocus", "field": "text to find" },
        { "type": "verify", "name": "replace_panel_open_with_find_text", "note": "fill the replacement field, then review before replacing all" }
      ]
    },
    "save_as_windows": {
      "name": "save the document under a new name (Windows)",
      "steps": [
        { "type": "pressKey", "key": "F12", "note": "Save As dialog" },
        { "type": "typeAtFocus", "field": "file name" },
        { "type": "verify", "name": "save_dialog_shows_intended_name_and_folder" },
        { "type": "pressKey", "key": "Return" }
      ]
    },
    "apply_heading": {
      "name": "turn the current paragraph into a heading",
      "steps": [
        { "type": "pressKey", "key": "mod+alt+1", "note": "use 2 or 3 for lower heading levels" }
      ]
    }
  },
  "tips": [
    "An empty chord for one OS means the vendor page lists no key for it there; use the ribbon or menu instead.",
    "Windows: ribbon KeyTips are tapped in sequence (alt, then h), not held together.",
    "Replace is ctrl+h on both Windows and Mac; Go To is ctrl+g on Windows and cmd+alt+g on Mac (F5 on both).",
    "Mac: F-key shortcuts may need Fn held; F8 and shift+F10 can collide with macOS system shortcuts.",
    "Mac: F1 to F4 alone are undo, cut, copy and paste in Word, unlike on Windows.",
    "mod+Return inserts a page break; shift+Return inserts a line break inside the same paragraph.",
    "Pressing F8 repeatedly grows the selection from word to sentence, paragraph, section and whole document; Escape leaves the mode.",
    "In a table, Tab in the last cell of the last row adds a new row."
  ],
  "sources": [
    "https://support.microsoft.com/en-us/office/keyboard-shortcuts-in-word-95ef89dd-7142-4b50-afb2-f762f663ceb2",
    "https://support.apple.com/en-us/102650"
  ],
  "lastVerified": "2026-11-18"
}

{
  "app": "discord",
  "name": "Discord",
  "kind": "desktop",
  "os": [
    "win32"
  ],
  "processNames": [
    "Discord"
  ],
  "shortcuts": {
    "show_hotkeys_list": "ctrl+/",
    "find_or_start_direct_message": "ctrl+k",
    "previous_server": "ctrl+alt+Up",
    "next_server": "ctrl+alt+Down",
    "previous_channel": "alt+Up",
    "next_channel": "alt+Down",
    "previous_unread_channel": "alt+shift+Up",
    "next_unread_channel": "alt+shift+Down",
    "previous_unread_channel_with_mentions": "ctrl+shift+alt+Up",
    "next_unread_channel_with_mentions": "ctrl+shift+alt+Down",
    "mark_channel_as_read": "Escape",
    "mark_server_as_read": "shift+Escape",
    "return_to_active_audio_channel": "ctrl+alt+a",
    "return_to_connected_audio_channel": "alt+Left",
    "toggle_pins_popout": "ctrl+p",
    "toggle_mentions_popout": "ctrl+i",
    "toggle_channel_member_list": "ctrl+u",
    "toggle_emoji_picker": "ctrl+e",
    "scroll_chat_up": "PageUp",
    "scroll_chat_down": "PageDown",
    "jump_to_oldest_unread_message": "shift+PageUp",
    "focus_text_area": "Tab",
    "upload_file": "ctrl+shift+u",
    "create_or_join_server": "ctrl+shift+n",
    "create_private_group": "ctrl+shift+t",
    "start_call_in_dm_or_group": "ctrl+[",
    "answer_incoming_call": "ctrl+Return",
    "decline_incoming_call": "Escape",
    "toggle_mute": "ctrl+shift+m",
    "toggle_deafen": "ctrl+shift+d",
    "get_help": "ctrl+shift+h"
  },
  "consequential": [
    "start_call_in_dm_or_group",
    "answer_incoming_call",
    "mark_server_as_read"
  ],
  "essentials": ["find_or_start_direct_message", "next_channel", "previous_channel", "next_unread_channel", "next_server", "focus_text_area", "upload_file", "toggle_mentions_popout"],
  "workflows": {
    "jump_to_dm_or_channel": {
      "name": "open a direct message, channel or server by name",
      "steps": [
        {
          "type": "pressKey",
          "key": "ctrl+k"
        },
        {
          "type": "wait",
          "ms": 300
        },
        {
          "type": "typeAtFocus",
          "field": "name"
        },
        {
          "type": "pressKey",
          "key": "Return"
        }
      ]
    }
  },
  "tips": [
    "ctrl+/ shows the full hotkey list inside Discord.",
    "Escape marks the current channel as read; while a call is ringing it declines the call instead.",
    "The vendor publishes these keys for Windows. Its macOS hotkey page is an image only, so the Mac keys are not listed here.",
    "The vendor page lists two different keys for returning to the previous text channel, so that action is left out."
  ],
  "sources": [
    "https://support.discord.com/hc/en-us/articles/225977308--Windows-Discord-Hotkeys"
  ],
  "lastVerified": "2026-11-18"
}

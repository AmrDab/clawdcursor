{
  "app": "excel",
  "name": "Microsoft Excel",
  "kind": "desktop",
  "os": ["win32", "darwin"],
  "processNames": ["EXCEL", "Microsoft Excel"],
  "shortcuts": {
    "new_workbook": "mod+n",
    "open_workbook": "mod+o",
    "save": "mod+s",
    "save_as": "F12",
    "close_workbook": "mod+w",
    "print": "mod+p",
    "quit_excel": { "default": "alt+F4", "darwin": "cmd+q" },
    "undo": "mod+z",
    "redo": "mod+y",
    "copy": "mod+c",
    "cut": "mod+x",
    "paste": "mod+v",
    "paste_special": "ctrl+alt+v",
    "clear_cell_contents": { "default": "Delete", "darwin": "Backspace" },
    "find": "ctrl+f",
    "replace": "ctrl+h",
    "go_to": "F5",
    "edit_cell": "F2",
    "cancel_entry": "Escape",
    "complete_entry_move_down": "Return",
    "complete_entry_move_up": "shift+Return",
    "complete_entry_move_right": "Tab",
    "complete_entry_move_left": "shift+Tab",
    "new_line_in_cell": "alt+Return",
    "fill_selection_with_entry": "ctrl+Return",
    "fill_down": "ctrl+d",
    "fill_right": { "default": "", "darwin": "cmd+r" },
    "flash_fill": { "default": "ctrl+e", "darwin": "" },
    "insert_cells": { "default": "ctrl+shift+Plus", "darwin": "ctrl+shift+=" },
    "delete_cells": "ctrl+-",
    "delete_column": { "default": "alt+h d c", "darwin": "" },
    "insert_new_sheet": "shift+F11",
    "enter_current_date": "ctrl+;",
    "enter_current_time": { "default": "ctrl+shift+:", "darwin": "cmd+;" },
    "copy_formula_from_cell_above": "ctrl+'",
    "copy_value_from_cell_above": "ctrl+shift+\"",
    "toggle_show_formulas": "ctrl+`",
    "insert_hyperlink": "mod+k",
    "insert_note": "shift+F2",
    "insert_threaded_comment": "mod+shift+F2",
    "create_table": "ctrl+t",
    "check_spelling": "F7",
    "insert_function": "shift+F3",
    "autosum": { "default": "alt+=", "darwin": "cmd+shift+t" },
    "toggle_absolute_reference": "F4",
    "expand_formula_bar": "ctrl+shift+u",
    "calculate_all_workbooks": "F9",
    "calculate_active_sheet": "shift+F9",
    "define_name": { "default": "alt+m m d", "darwin": "ctrl+l" },
    "create_chart_sheet": "F11",
    "create_embedded_chart": { "default": "alt+F1", "darwin": "" },
    "open_macros_dialog": "alt+F8",
    "format_cells_dialog": "ctrl+1",
    "bold": "mod+b",
    "italic": "mod+i",
    "underline": "mod+u",
    "strikethrough": { "default": "ctrl+5", "darwin": "cmd+shift+x" },
    "format_general": "ctrl+shift+~",
    "format_currency": "ctrl+shift+$",
    "format_percent": "ctrl+shift+%",
    "format_scientific": "ctrl+shift+^",
    "format_date": "ctrl+shift+#",
    "format_time": "ctrl+shift+@",
    "format_number_two_decimals": "ctrl+shift+!",
    "outline_border": { "default": "ctrl+shift+&", "darwin": "cmd+alt+0" },
    "remove_borders": { "default": "ctrl+shift+_", "darwin": "cmd+alt+-" },
    "center_align": { "default": "alt+h a c", "darwin": "cmd+e" },
    "left_align": { "default": "", "darwin": "cmd+l" },
    "fill_color_menu": { "default": "alt+h h", "darwin": "" },
    "borders_menu": { "default": "alt+h b", "darwin": "" },
    "hide_rows": "ctrl+9",
    "hide_columns": "ctrl+0",
    "unhide_rows": { "default": "", "darwin": "ctrl+shift+(" },
    "unhide_columns": { "default": "", "darwin": "ctrl+shift+)" },
    "toggle_filter": { "default": "", "darwin": "cmd+shift+f" },
    "open_sort_dialog": { "default": "", "darwin": "cmd+shift+r" },
    "open_dropdown_or_filter_list": "alt+Down",
    "move_to_data_edge_up": "mod+Up",
    "move_to_data_edge_down": "mod+Down",
    "move_to_data_edge_left": "mod+Left",
    "move_to_data_edge_right": "mod+Right",
    "go_to_row_start": "Home",
    "go_to_sheet_start": "ctrl+Home",
    "go_to_last_used_cell": "ctrl+End",
    "screen_down": "PageDown",
    "screen_up": "PageUp",
    "screen_right": "alt+PageDown",
    "screen_left": "alt+PageUp",
    "next_sheet": "ctrl+PageDown",
    "previous_sheet": { "default": "ctrl+PageUp", "darwin": "alt+Left" },
    "select_all": "mod+a",
    "select_column": "ctrl+Space",
    "select_row": "shift+Space",
    "extend_selection_up": "shift+Up",
    "extend_selection_down": "shift+Down",
    "extend_selection_left": "shift+Left",
    "extend_selection_right": "shift+Right",
    "extend_selection_to_data_edge_up": "mod+shift+Up",
    "extend_selection_to_data_edge_down": "mod+shift+Down",
    "extend_selection_to_data_edge_left": "mod+shift+Left",
    "extend_selection_to_data_edge_right": "mod+shift+Right",
    "extend_selection_to_sheet_start": "ctrl+shift+Home",
    "extend_selection_to_last_used_cell": "ctrl+shift+End",
    "select_current_region": { "default": "ctrl+shift+*", "darwin": "" },
    "select_visible_cells": { "default": "", "darwin": "cmd+shift+*" },
    "toggle_extend_selection_mode": "F8",
    "add_range_to_selection": "shift+F8",
    "context_menu": "shift+F10",
    "switch_pane": "F6",
    "toggle_ribbon": { "default": "ctrl+F1", "darwin": "cmd+alt+r" },
    "show_ribbon_key_tips": { "default": "alt", "darwin": "" },
    "ribbon_search_box": { "default": "alt+q", "darwin": "" },
    "file_menu": { "default": "alt+f", "darwin": "" },
    "home_tab": { "default": "alt+h", "darwin": "" },
    "insert_tab": { "default": "alt+n", "darwin": "" },
    "page_layout_tab": { "default": "alt+p", "darwin": "" },
    "formulas_tab": { "default": "alt+m", "darwin": "" },
    "data_tab": { "default": "alt+a", "darwin": "" },
    "review_tab": { "default": "alt+r", "darwin": "" },
    "view_tab": { "default": "alt+w", "darwin": "" },
    "help": "F1"
  },
  "consequential": ["close_workbook", "quit_excel", "delete_column"],
  "essentials": ["go_to", "edit_cell", "save", "go_to_sheet_start", "move_to_data_edge_down", "move_to_data_edge_right", "next_sheet", "format_cells_dialog"],
  "workflows": {
    "find_value": {
      "name": "find a value on the sheet",
      "steps": [
        { "type": "pressKey", "key": "ctrl+f", "note": "opens Find on Windows and Mac" },
        { "type": "typeAtFocus", "field": "search text" },
        { "type": "pressKey", "key": "Return" }
      ]
    },
    "go_to_cell": {
      "name": "jump to a cell or named range",
      "steps": [
        { "type": "pressKey", "key": "F5", "note": "Go To dialog" },
        { "type": "typeAtFocus", "field": "cell reference or name" },
        { "type": "pressKey", "key": "Return" }
      ]
    },
    "paste_values_only": {
      "name": "paste values without formulas (Windows)",
      "steps": [
        { "type": "pressKey", "key": "ctrl+alt+v", "note": "Paste Special dialog, after copying" },
        { "type": "pressKey", "key": "v", "note": "the Values option" },
        { "type": "pressKey", "key": "Return" }
      ]
    },
    "save_as": {
      "name": "save the workbook under a new name",
      "steps": [
        { "type": "pressKey", "key": "F12", "note": "Save As dialog" },
        { "type": "typeAtFocus", "field": "file name" },
        { "type": "verify", "name": "save_dialog_shows_intended_name_and_folder" },
        { "type": "pressKey", "key": "Return" }
      ]
    }
  },
  "tips": [
    "An empty chord for one OS means the vendor page lists no key for it there; use the ribbon or menu instead.",
    "Windows: tapping alt shows KeyTips letters on the ribbon; sequences such as alt+h a c are pressed one key after another, not held together.",
    "Mac: function-key shortcuts (F2, F5, F8, F11, F12) may need Fn held unless macOS is set to use F-keys as standard function keys.",
    "Mac: ctrl+Space, F11 and shift+F11 can collide with macOS system shortcuts and only work in Excel once the system shortcut is turned off.",
    "Pressing select_all again widens the selection from the current data region to the whole sheet.",
    "In the Windows Paste Special dialog each option has a letter: v values, f formulas, t formats, w column widths.",
    "Delete (Backspace on a Mac keyboard) clears cell contents but keeps formatting and comments.",
    "Return moves down after an entry by default; on Mac the direction can be changed in Excel preferences."
  ],
  "sources": [
    "https://support.microsoft.com/en-us/office/keyboard-shortcuts-in-excel-1798d9d5-842a-42b8-9c99-9b7213f0040f",
    "https://support.microsoft.com/en-us/office/find-or-replace-text-and-numbers-on-a-worksheet-0e304ca5-ecef-4808-b90f-fdb42f892e90",
    "https://support.microsoft.com/en-us/office/create-a-new-workbook-ae99f19b-cecb-4aa0-92c8-7126d6212a83",
    "https://support.microsoft.com/en-us/office/print-a-worksheet-or-workbook-f4ad7962-b1d5-4eb9-a24f-0907f36c4b94"
  ],
  "lastVerified": "2026-11-18"
}

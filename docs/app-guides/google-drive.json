{
  "app": "google-drive",
  "name": "Google Drive",
  "kind": "web",
  "domainHints": ["drive.google.com"],
  "shortcuts": {
    "go_to_navigation_panel": "alt+g f",
    "go_to_items_view": "alt+g i",
    "go_to_page_content": "alt+g c",
    "go_to_details_pane": "alt+g d",
    "go_to_top_bar": "alt+g t",
    "go_to_download_status": "alt+g a",
    "go_to_upload_status": "alt+g u",
    "show_last_message": "alt+g k",
    "toggle_grid_list_view": "alt+v l",
    "toggle_details_pane": "alt+v d",
    "toggle_activity_pane": "alt+v a",
    "toggle_approvals_pane": "alt+v e",
    "toggle_item_selection": "shift+Space",
    "select_item_below": "Down",
    "select_item_above": "Up",
    "select_item_left": "Left",
    "select_item_right": "Right",
    "extend_selection_down": "shift+Down",
    "extend_selection_up": "shift+Up",
    "extend_selection_left": "shift+Left",
    "extend_selection_right": "shift+Right",
    "select_all_visible_items": "mod+a",
    "clear_selection": "Escape",
    "move_down_keep_selection": "mod+Down",
    "move_up_keep_selection": "mod+Up",
    "move_left_keep_selection": "mod+Left",
    "move_right_keep_selection": "mod+Right",
    "open_selected": "Return",
    "open_selected_in_new_tab": "mod+Return",
    "rename_selected": "F2",
    "share_selected": "mod+alt+a",
    "move_selected_to_folder": "mod+alt+m",
    "toggle_star_selected": "mod+alt+s",
    "remove_selected": "Delete",
    "copy_selected_links": "mod+alt+l",
    "copy_selected_titles": "mod+shift+c",
    "preview_selected": "mod+alt+p",
    "upload_file": { "default": "alt+c u", "darwin": "ctrl+c u" },
    "upload_folder": { "default": "alt+c i", "darwin": "ctrl+c i" },
    "new_document": { "default": "alt+c t", "darwin": "ctrl+c t" },
    "new_presentation": { "default": "alt+c p", "darwin": "ctrl+c p" },
    "new_spreadsheet": { "default": "alt+c s", "darwin": "ctrl+c s" },
    "new_drawing": { "default": "alt+c d", "darwin": "ctrl+c d" },
    "new_folder": { "default": "alt+c f", "darwin": "ctrl+c f" },
    "new_form": { "default": "alt+c o", "darwin": "ctrl+c o" },
    "open_create_menu": { "default": "alt+n", "darwin": "ctrl+n" },
    "open_more_actions_menu": "shift+F10",
    "open_folder_actions_menu": { "default": "alt+shift+a", "darwin": "ctrl+shift+a" },
    "open_sort_menu": { "default": "alt+r", "darwin": "ctrl+r" },
    "open_settings_menu": "mod+shift+s",
    "next_visual_density": { "default": "alt+t q", "darwin": "ctrl+t q" },
    "search_drive": "/",
    "find": "mod+f",
    "print": "mod+p",
    "undo": "mod+z",
    "redo": "mod+y",
    "show_shortcut_list": "mod+/",
    "close_preview": "Escape",
    "preview_play_pause": "Space",
    "preview_zoom_in": "=",
    "preview_zoom_out": "-"
  },
  "consequential": ["remove_selected"],
  "essentials": ["search_drive", "go_to_items_view", "open_selected", "new_folder", "new_document", "upload_file", "rename_selected", "share_selected"],
  "workflows": {
    "search": {
      "name": "search Drive",
      "steps": [
        { "type": "pressKey", "key": "/", "note": "focuses the search box" },
        { "type": "typeAtFocus", "field": "query" },
        { "type": "pressKey", "key": "Return" }
      ]
    }
  },
  "tips": [
    "mod+/ shows the shortcut list inside Drive.",
    "Sequences such as alt+g i are the modifier chord first, then the letter on its own. alt is Option on a Mac.",
    "On a Mac the create, upload and menu shortcuts use Control where Windows and ChromeOS use Alt (new folder: Control+c then f); the go-to and view sequences use Option.",
    "Item shortcuts act on the selection in the items view. alt+g i moves focus to the items view; arrows move the selection and shift+Space toggles the focused item.",
    "remove_selected also works as #. open_more_actions_menu can also be Alt+a on Windows and Control+a on a Mac.",
    "Preview keys (Space, = and -, Escape) apply only while a file preview is open.",
    "Some shortcuts might not work for all languages or keyboards."
  ],
  "sources": [
    "https://support.google.com/drive/answer/2563044"
  ],
  "lastVerified": "2026-11-18"
}

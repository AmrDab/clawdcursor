{
  "app": "edge",
  "name": "Microsoft Edge",
  "kind": "desktop",
  "os": ["win32", "darwin"],
  "processNames": ["msedge", "Microsoft Edge"],
  "shortcuts": {
    "new_tab": "mod+t",
    "new_window": "mod+n",
    "new_inprivate_window": "mod+shift+n",
    "reopen_closed_tab": "mod+shift+t",
    "duplicate_tab": { "default": "ctrl+shift+k", "darwin": "" },
    "close_tab": "mod+w",
    "close_window": "mod+shift+w",
    "quit_edge": { "default": "", "darwin": "cmd+q" },
    "next_tab": { "default": "ctrl+Tab", "darwin": "cmd+PageDown" },
    "previous_tab": { "default": "ctrl+shift+Tab", "darwin": "cmd+PageUp" },
    "go_to_tab_1": "mod+1",
    "go_to_tab_2": "mod+2",
    "go_to_tab_3": "mod+3",
    "go_to_last_tab": "mod+9",
    "back": { "default": "alt+Left", "darwin": "cmd+[" },
    "forward": { "default": "alt+Right", "darwin": "cmd+]" },
    "reload": "mod+r",
    "reload_ignoring_cache": "mod+shift+r",
    "stop_loading": "Escape",
    "open_home_page": { "default": "alt+Home", "darwin": "cmd+shift+h" },
    "focus_address_bar": "mod+l",
    "search_from_address_bar": { "default": "ctrl+e", "darwin": "cmd+alt+f" },
    "paste_and_go": { "default": "ctrl+shift+l", "darwin": "" },
    "address_bar_add_www_and_com": { "default": "ctrl+Return", "darwin": "" },
    "address_bar_search_in_new_tab": { "default": "", "darwin": "cmd+Return" },
    "find_on_page": "mod+f",
    "find_next": "mod+g",
    "find_previous": "mod+shift+g",
    "open_history": { "default": "ctrl+h", "darwin": "cmd+y" },
    "open_downloads": { "default": "ctrl+j", "darwin": "cmd+alt+l" },
    "open_favorites": { "default": "ctrl+shift+o", "darwin": "" },
    "toggle_favorites_bar": "mod+shift+b",
    "add_favorite": "mod+d",
    "add_all_tabs_to_favorites": "mod+shift+d",
    "open_collections": { "default": "ctrl+shift+y", "darwin": "" },
    "open_settings_and_more_menu": { "default": "alt+f", "darwin": "" },
    "open_search_in_sidebar": "mod+shift+e",
    "open_developer_tools": "F12",
    "view_page_source": { "default": "ctrl+u", "darwin": "" },
    "open_clear_browsing_data": { "default": "ctrl+shift+Delete", "darwin": "cmd+shift+Backspace" },
    "print": "mod+p",
    "save_page": "mod+s",
    "open_file": "mod+o",
    "paste_without_formatting": "mod+shift+v",
    "zoom_in": "mod+Plus",
    "zoom_out": "mod+-",
    "reset_zoom": "mod+0",
    "toggle_full_screen": { "default": "F11", "darwin": "cmd+ctrl+f" },
    "mute_tab": "ctrl+m",
    "toggle_read_aloud": "mod+shift+u",
    "toggle_immersive_reader": "F9",
    "scroll_down_one_screen": "Space",
    "scroll_up_one_screen": "shift+Space",
    "go_to_page_top": { "default": "Home", "darwin": "" },
    "go_to_page_bottom": { "default": "End", "darwin": "" },
    "next_control": "Tab",
    "previous_control": "shift+Tab",
    "next_pane": { "default": "F6", "darwin": "" },
    "focus_web_content": { "default": "ctrl+F6", "darwin": "" },
    "context_menu": { "default": "shift+F10", "darwin": "" },
    "switch_profile_or_guest": "mod+shift+m",
    "minimize_window": { "default": "", "darwin": "cmd+m" },
    "toggle_caret_browsing": { "default": "F7", "darwin": "" },
    "help": { "default": "F1", "darwin": "" }
  },
  "consequential": ["close_tab", "close_window", "quit_edge"],
  "essentials": ["focus_address_bar", "new_tab", "next_tab", "previous_tab", "back", "find_on_page", "reload", "open_downloads"],
  "workflows": {
    "open_url_in_new_tab": {
      "name": "open a web address in a new tab",
      "steps": [
        { "type": "pressKey", "key": "mod+t", "note": "opens a new tab and switches to it" },
        { "type": "pressKey", "key": "mod+l", "note": "selects the address bar" },
        { "type": "typeAtFocus", "field": "web address or search" },
        { "type": "pressKey", "key": "Return" }
      ]
    },
    "find_on_page": {
      "name": "find text on the current page",
      "steps": [
        { "type": "pressKey", "key": "mod+f" },
        { "type": "typeAtFocus", "field": "search text" },
        { "type": "pressKey", "key": "Return", "note": "mod+g moves to the next result" }
      ]
    }
  },
  "tips": [
    "These are the browser's own keys; web pages can define their own shortcuts on top of them.",
    "An empty chord for one OS means Microsoft's page lists no key for it there; use the menu instead.",
    "mod+1 to mod+8 switch to a tab by position; mod+9 goes to the last tab.",
    "Tab switching differs by OS: ctrl+Tab on Windows; on Mac the page gives cmd+Fn+Down, sent here as cmd+PageDown.",
    "Mute tab is ctrl+m on both Windows and Mac; cmd+m minimizes the window on Mac.",
    "History is ctrl+h on Windows and cmd+y on Mac; Downloads is ctrl+j on Windows and cmd+alt+l on Mac.",
    "On Windows alt+d and F4 also select the address bar, and F5 reloads."
  ],
  "sources": [
    "https://support.microsoft.com/en-us/microsoft-edge/keyboard-shortcuts-in-microsoft-edge-50d3edab-30d9-c7e4-21ce-37fe2713cfad"
  ],
  "lastVerified": "2026-11-18"
}

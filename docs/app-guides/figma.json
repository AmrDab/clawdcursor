{
  "app": "figma",
  "name": "Figma",
  "kind": "desktop",
  "processNames": [
    "Figma"
  ],
  "domainHints": [
    "figma.com",
    "www.figma.com"
  ],
  "shortcuts": {
    "open_actions_menu": "mod+k",
    "open_shortcuts_panel": "ctrl+shift+?",
    "focus_next_interface_region": {
      "default": "ctrl+F6",
      "darwin": "F6"
    },
    "zoom_in": "mod+Plus",
    "zoom_out": "mod+-",
    "zoom_to_fit": "shift+1",
    "zoom_to_selection": "shift+2",
    "toggle_pixel_preview": {
      "default": "ctrl+alt+p",
      "darwin": "ctrl+p"
    },
    "toggle_pixel_grid": "mod+'",
    "toggle_snap_to_pixel_grid": "mod+shift+'",
    "toggle_layout_guides": {
      "default": "ctrl+shift+4",
      "darwin": "ctrl+g"
    },
    "toggle_multiplayer_cursors": "mod+alt+\\",
    "hand_tool": "h",
    "frame_tool": "f",
    "section_tool": "shift+s",
    "rectangle_tool": "r",
    "line_tool": "l",
    "arrow_tool": "shift+l",
    "ellipse_tool": "o",
    "pen_tool": "p",
    "text_tool": "t",
    "comment_tool": "c",
    "annotation_tool": "shift+t",
    "place_image_or_video": "mod+shift+k",
    "toggle_dev_mode": "shift+d",
    "keyboard_selection_tool": {
      "default": "ctrl+Space",
      "darwin": "alt+Space"
    },
    "select_all": "mod+a",
    "select_inverse": "mod+shift+a",
    "select_matching_layers": "mod+alt+a",
    "deselect_all": "Escape",
    "select_child_layer": "Return",
    "select_parent_layer": "shift+Return",
    "select_next_sibling": "Tab",
    "select_previous_sibling": "shift+Tab",
    "copy": "mod+c",
    "paste": "mod+v",
    "duplicate": "mod+d",
    "paste_to_replace": "mod+shift+r",
    "paste_over_selection": "mod+shift+v",
    "copy_as_png": "mod+shift+c",
    "group_selection": "mod+g",
    "ungroup_selection": "mod+shift+g",
    "frame_selection": "mod+alt+g",
    "add_auto_layout": "shift+a",
    "create_component": "mod+alt+k",
    "resize_frame_to_fit_contents": "mod+alt+shift+r"
  },
  "essentials": ["open_actions_menu", "frame_tool", "rectangle_tool", "text_tool", "select_child_layer", "select_next_sibling", "zoom_to_fit", "zoom_to_selection"],
  "workflows": {
    "run_action_by_name": {
      "name": "run a command, tool or plugin by name",
      "steps": [
        {
          "type": "pressKey",
          "key": "mod+k",
          "note": "actions menu"
        },
        {
          "type": "wait",
          "ms": 300
        },
        {
          "type": "typeAtFocus",
          "field": "action name, for example align or Keyboard shortcuts"
        },
        {
          "type": "pressKey",
          "key": "Return"
        }
      ]
    },
    "place_object_with_keyboard": {
      "name": "add a frame, shape or text layer without the mouse",
      "steps": [
        {
          "type": "pressKey",
          "key": "r",
          "note": "any tool key: f frame, r rectangle, o ellipse, t text"
        },
        {
          "type": "verify",
          "name": "crosshair_cursor_on_canvas",
          "note": "arrow keys move the crosshair"
        },
        {
          "type": "pressKey",
          "key": "Return",
          "note": "places the object"
        }
      ]
    }
  },
  "tips": [
    "The same shortcuts apply in the desktop app and in the browser editor.",
    "Figma has no single web page of shortcuts; the full list is the in-app shortcuts panel (ctrl+shift+? on both Windows and Mac), with tabs by category.",
    "With nothing selected, the arrow keys pan the canvas and shift+arrow pans further.",
    "Lines, vector paths, connectors and tables need several clicks and cannot be placed with the keyboard alone.",
    "Return enters a selected frame or group (select child); on a text layer it starts text editing, on a vector layer vector edit mode.",
    "Holding Space gives the hand tool temporarily; holding alt while dragging duplicates the layer.",
    "ungroup_selection also removes a frame around its children.",
    "Shortcuts assume a US QWERTY layout; another layout can be chosen in the Layout tab of the shortcuts panel."
  ],
  "sources": [
    "https://help.figma.com/hc/en-us/articles/360040328653-Use-Figma-products-with-a-keyboard",
    "https://help.figma.com/hc/en-us/articles/35063862380311-Accessibility-at-Figma",
    "https://help.figma.com/hc/en-us/articles/360041065034-Adjust-your-zoom-and-view-options",
    "https://help.figma.com/hc/en-us/articles/360041064174-Access-design-tools-from-the-toolbar",
    "https://help.figma.com/hc/en-us/articles/15297425105303-Explore-design-files",
    "https://help.figma.com/hc/en-us/articles/360040450133-Shape-tools",
    "https://help.figma.com/hc/en-us/articles/360041539473-Frames-in-Figma-Design",
    "https://help.figma.com/hc/en-us/articles/360039832054-The-difference-between-frames-and-groups",
    "https://help.figma.com/hc/en-us/articles/360040449873-Select-layers-and-objects",
    "https://help.figma.com/hc/en-us/articles/4409078832791-Copy-and-paste-objects",
    "https://help.figma.com/hc/en-us/articles/360039957634-Edit-vector-layers"
  ],
  "lastVerified": "2026-11-18"
}

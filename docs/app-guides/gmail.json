{
  "app": "gmail",
  "name": "Gmail",
  "kind": "web",
  "domainHints": ["mail.google.com", "gmail.com"],
  "shortcuts": {
    "compose": "c",
    "compose_in_new_tab": "d",
    "send": "mod+Return",
    "discard_draft": "mod+shift+d",
    "add_cc_recipients": "mod+shift+c",
    "add_bcc_recipients": "mod+shift+b",
    "insert_link": "mod+k",
    "open_spelling_suggestions": "mod+m",
    "focus_main_window": "shift+Escape",
    "focus_latest_chat_or_compose": "Escape",
    "next_chat_or_compose": "ctrl+.",
    "previous_chat_or_compose": "ctrl+,",
    "bold": "mod+b",
    "italic": "mod+i",
    "underline": "mod+u",
    "numbered_list": "mod+shift+7",
    "bulleted_list": "mod+shift+8",
    "quote": "mod+shift+9",
    "indent_less": "mod+[",
    "indent_more": "mod+]",
    "align_left": "mod+shift+l",
    "align_center": "mod+shift+e",
    "align_right": "mod+shift+r",
    "previous_font": "mod+shift+5",
    "next_font": "mod+shift+6",
    "decrease_text_size": "mod+shift+-",
    "remove_formatting": "mod+\\",
    "reply": "r",
    "reply_in_new_window": "shift+r",
    "reply_all": "a",
    "reply_all_in_new_window": "shift+a",
    "forward": "f",
    "forward_in_new_window": "shift+f",
    "archive": "e",
    "delete": "#",
    "report_spam": "!",
    "mute_conversation": "m",
    "snooze": "b",
    "toggle_star": "s",
    "mark_read": "shift+i",
    "mark_unread": "shift+u",
    "mark_unread_from_selected_message": "_",
    "mark_important": "=",
    "mark_not_important": "-",
    "add_to_tasks": "shift+t",
    "remove_label": "y",
    "undo_last_action": "z",
    "update_conversation": "shift+n",
    "select_conversation": "x",
    "focus_toolbar": ",",
    "expand_conversation": ";",
    "collapse_conversation": ":",
    "open_more_actions_menu": ".",
    "open_move_to_menu": "v",
    "open_label_as_menu": "l",
    "go_to_inbox": "g i",
    "go_to_starred": "g s",
    "go_to_snoozed": "g b",
    "go_to_sent": "g t",
    "go_to_drafts": "g d",
    "go_to_all_mail": "g a",
    "go_to_tasks": "g k",
    "go_to_label": "g l",
    "go_to_next_page": "g n",
    "go_to_previous_page": "g p",
    "focus_side_panel_next": "mod+alt+.",
    "focus_side_panel_previous": "mod+alt+,",
    "select_all_conversations": "* a",
    "deselect_all_conversations": "* n",
    "select_read_conversations": "* r",
    "select_unread_conversations": "* u",
    "select_starred_conversations": "* s",
    "select_unstarred_conversations": "* t",
    "older_conversation": "j",
    "newer_conversation": "k",
    "open_conversation": "o",
    "back_to_thread_list": "u",
    "next_message_in_conversation": "n",
    "previous_message_in_conversation": "p",
    "next_inbox_section": "`",
    "previous_inbox_section": "~",
    "search_mail": "/",
    "search_chat_contacts": "q",
    "open_shortcut_help": "?"
  },
  "consequential": ["send", "delete", "report_spam", "discard_draft"],
  "essentials": ["compose", "send", "search_mail", "go_to_inbox", "older_conversation", "open_conversation", "reply", "archive"],
  "workflows": {
    "compose_and_send": {
      "name": "compose and send an email",
      "steps": [
        { "type": "pressKey", "key": "c", "note": "opens a new message" },
        { "type": "wait", "ms": 800, "note": "compose window appears" },
        { "type": "verify", "name": "to_field_focused" },
        { "type": "typeAtFocus", "field": "recipient", "note": "part of a name or the full address" },
        { "type": "pressKey", "key": "Return", "note": "picks the suggested contact" },
        { "type": "pressKey", "key": "Tab", "note": "moves on to Subject" },
        { "type": "verify", "name": "subject_field_focused" },
        { "type": "typeAtFocus", "field": "subject" },
        { "type": "pressKey", "key": "Tab", "note": "moves on to the message body" },
        { "type": "typeAtFocus", "field": "body" },
        { "type": "pressKey", "key": "mod+Return", "note": "sends and closes the draft" },
        { "type": "verify", "name": "sent_confirmation" }
      ]
    },
    "reply": {
      "name": "reply to the open email",
      "steps": [
        { "type": "pressKey", "key": "r", "note": "reply to the sender; a replies to all" },
        { "type": "wait", "ms": 400 },
        { "type": "typeAtFocus", "field": "body" },
        { "type": "pressKey", "key": "mod+Return", "note": "sends" },
        { "type": "verify", "name": "sent_confirmation" }
      ]
    },
    "search": {
      "name": "search mail",
      "steps": [
        { "type": "pressKey", "key": "/", "note": "focuses the search box" },
        { "type": "typeAtFocus", "field": "query" },
        { "type": "pressKey", "key": "Return" }
      ]
    }
  },
  "tips": [
    "The single-key and two-key shortcuts (c, /, r, e, #, x, g i, * a and the like) work only when Settings > See all settings > Keyboard shortcuts is on. The mod-key compose and formatting shortcuts are not tied to that setting.",
    "Press ? to open the shortcut list. From there one Tab reaches a link named Enable or Disable; if it says Enable, Return turns the shortcuts on.",
    "Single keys typed into the search box or a draft are text. shift+Escape moves focus back to the main window; Escape moves it to the latest chat or compose window.",
    "Action keys apply to the open conversation, or in the list to the conversations selected with x. j and k move through the list (j older, k newer); o or Return opens the focused one.",
    "In a new message Tab moves through To, Subject and the message body. In To, Cc or Bcc, type part of a name or address and press Return to choose the suggestion.",
    "Drafts are saved on their own a few seconds after typing stops. Escape closes the compose window and keeps the draft; mod+shift+d discards it.",
    "z undoes the most recent action, such as an archive or a move.",
    "Users can remap keys under Settings > Keyboard Shortcuts (custom keyboard shortcuts), so a key may differ on some accounts. Shortcuts are also not supported on every language or keyboard."
  ],
  "sources": [
    "https://support.google.com/mail/answer/6594",
    "https://support.google.com/mail/answer/90559"
  ],
  "lastVerified": "2026-11-18"
}

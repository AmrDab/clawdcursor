{
  "app": "powerpoint",
  "name": "Microsoft PowerPoint",
  "kind": "desktop",
  "os": ["win32", "darwin"],
  "processNames": ["POWERPNT", "Microsoft PowerPoint"],
  "shortcuts": {
    "new_presentation": "mod+n",
    "open_presentation": "mod+o",
    "save": "mod+s",
    "save_as": "mod+shift+s",
    "print": "mod+p",
    "close_presentation": { "default": "", "darwin": "cmd+w" },
    "quit_powerpoint": "mod+q",
    "new_slide": { "default": "ctrl+m", "darwin": "cmd+shift+n" },
    "duplicate_slide": "mod+shift+d",
    "next_slide": "PageDown",
    "previous_slide": "PageUp",
    "move_slide_up": "mod+Up",
    "move_slide_down": "mod+Down",
    "move_slide_to_start": "mod+shift+Up",
    "move_slide_to_end": "mod+shift+Down",
    "start_slide_show": { "default": "F5", "darwin": "cmd+shift+Return" },
    "end_slide_show": "Escape",
    "presenter_view": { "default": "alt+F5", "darwin": "alt+Return" },
    "undo": "mod+z",
    "redo": "mod+y",
    "cut": "mod+x",
    "copy": "mod+c",
    "paste": "mod+v",
    "paste_special": { "default": "ctrl+alt+v", "darwin": "cmd+ctrl+v" },
    "duplicate_object": "ctrl+d",
    "copy_formatting": "mod+shift+c",
    "paste_formatting": "mod+shift+v",
    "select_all": "mod+a",
    "select_next_object": "Tab",
    "select_previous_object": "shift+Tab",
    "edit_text_in_selected_object": "Return",
    "select_object_from_its_text": "Escape",
    "group_objects": { "default": "ctrl+g", "darwin": "cmd+alt+g" },
    "ungroup_objects": { "default": "ctrl+shift+g", "darwin": "cmd+alt+shift+g" },
    "regroup_objects": { "default": "ctrl+shift+j", "darwin": "cmd+alt+j" },
    "bring_forward": { "default": "ctrl+shift+]", "darwin": "cmd+alt+shift+f" },
    "send_backward": { "default": "ctrl+shift+[", "darwin": "cmd+alt+shift+b" },
    "bring_to_front": { "default": "", "darwin": "cmd+shift+f" },
    "send_to_back": { "default": "", "darwin": "cmd+shift+b" },
    "rotate_clockwise_15": "alt+Right",
    "rotate_counterclockwise_15": "alt+Left",
    "focus_first_floating_shape": { "default": "ctrl+alt+5", "darwin": "" },
    "insert_hyperlink": "mod+k",
    "insert_comment": { "default": "ctrl+alt+m", "darwin": "cmd+shift+m" },
    "insert_equation": { "default": "alt+=", "darwin": "" },
    "find": "mod+f",
    "replace": { "default": "ctrl+h", "darwin": "cmd+shift+h" },
    "bold": "mod+b",
    "italic": "mod+i",
    "underline": "mod+u",
    "font_dialog": "mod+t",
    "increase_font_size": "mod+shift+>",
    "decrease_font_size": "mod+shift+<",
    "cycle_letter_case": "shift+F3",
    "subscript": { "default": "ctrl+=", "darwin": "cmd+ctrl+=" },
    "superscript": { "default": "ctrl+shift+Plus", "darwin": "cmd+ctrl+shift+=" },
    "clear_character_formatting": "ctrl+Space",
    "align_center": "mod+e",
    "align_left": "mod+l",
    "align_right": "mod+r",
    "justify": "mod+j",
    "promote_paragraph": { "default": "alt+shift+Left", "darwin": "cmd+[" },
    "demote_paragraph": { "default": "alt+shift+Right", "darwin": "cmd+]" },
    "move_paragraph_up": { "default": "alt+shift+Up", "darwin": "" },
    "move_paragraph_down": { "default": "alt+shift+Down", "darwin": "" },
    "next_placeholder": { "default": "ctrl+Return", "darwin": "" },
    "word_left": { "default": "ctrl+Left", "darwin": "alt+Left" },
    "word_right": { "default": "ctrl+Right", "darwin": "alt+Right" },
    "line_start": "Home",
    "line_end": "End",
    "paragraph_up": { "default": "ctrl+Up", "darwin": "alt+Up" },
    "paragraph_down": { "default": "ctrl+Down", "darwin": "alt+Down" },
    "text_box_start": { "default": "ctrl+Home", "darwin": "cmd+Up" },
    "text_box_end": { "default": "ctrl+End", "darwin": "cmd+Down" },
    "select_word_left": { "default": "ctrl+shift+Left", "darwin": "shift+alt+Left" },
    "select_word_right": { "default": "ctrl+shift+Right", "darwin": "shift+alt+Right" },
    "select_to_paragraph_start": { "default": "ctrl+shift+Up", "darwin": "shift+alt+Up" },
    "select_to_paragraph_end": { "default": "ctrl+shift+Down", "darwin": "shift+alt+Down" },
    "delete_word_left": { "default": "ctrl+Backspace", "darwin": "cmd+Backspace" },
    "table_next_cell": "Tab",
    "table_previous_cell": "shift+Tab",
    "insert_tab_in_table_cell": { "default": "ctrl+Tab", "darwin": "alt+shift+Tab" },
    "toggle_outline_and_thumbnails": "ctrl+shift+Tab",
    "next_pane": "F6",
    "previous_pane": "shift+F6",
    "normal_view": { "default": "", "darwin": "cmd+1" },
    "slide_sorter_view": { "default": "", "darwin": "cmd+2" },
    "notes_page_view": { "default": "", "darwin": "cmd+3" },
    "outline_view": { "default": "", "darwin": "cmd+4" },
    "full_screen": { "default": "ctrl+F1", "darwin": "cmd+ctrl+f" },
    "toggle_guides": { "default": "alt+F9", "darwin": "cmd+alt+ctrl+g" },
    "toggle_grid": "shift+F9",
    "zoom_in": "mod+Plus",
    "zoom_out": "mod+-",
    "zoom_to_fit": "mod+alt+o",
    "help": "F1"
  },
  "consequential": ["close_presentation", "quit_powerpoint"],
  "essentials": ["new_slide", "next_slide", "previous_slide", "select_next_object", "edit_text_in_selected_object", "duplicate_slide", "save", "start_slide_show"],
  "workflows": {
    "find_text": {
      "name": "find text in the presentation",
      "steps": [
        { "type": "pressKey", "key": "mod+f", "note": "Find dialog on Windows, search field on Mac" },
        { "type": "typeAtFocus", "field": "search text" },
        { "type": "pressKey", "key": "Return" }
      ]
    },
    "save_as": {
      "name": "save the presentation under a new name or format",
      "steps": [
        { "type": "pressKey", "key": "mod+shift+s" },
        { "type": "typeAtFocus", "field": "file name" },
        { "type": "verify", "name": "save_dialog_shows_intended_name_and_folder" },
        { "type": "pressKey", "key": "Return" }
      ]
    }
  },
  "tips": [
    "An empty chord for one OS means the vendor page lists no key for it there; use the ribbon or menu instead.",
    "New slide is ctrl+m on Windows but cmd+shift+n on Mac; on Mac cmd+n makes a whole new presentation.",
    "ctrl+d duplicates the selected object; the vendor page gives no separate Windows key for closing a presentation, so close it from the File menu.",
    "Windows: ctrl+Return jumps to the next title or body placeholder and, from the last one, adds a new slide with the same layout.",
    "With an object selected, Return enters its text; Escape steps back out to the object, and also ends a running slide show.",
    "Slide-moving keys (mod+Up, mod+Down) act on the selected slide or section, not on text.",
    "At the start of a line, typing * or - followed by Space starts a bulleted list."
  ],
  "sources": [
    "https://support.microsoft.com/en-us/office/use-keyboard-shortcuts-to-create-powerpoint-presentations-ebb3d20e-dcd4-444f-a38e-bb5c5ed180f4"
  ],
  "lastVerified": "2026-11-18"
}

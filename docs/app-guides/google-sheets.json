{
  "app": "google-sheets",
  "name": "Google Sheets",
  "kind": "web",
  "domainHints": ["docs.google.com/spreadsheets", "sheets.google.com"],
  "shortcuts": {
    "select_column": "ctrl+Space",
    "select_row": "shift+Space",
    "select_all": "mod+a",
    "undo": "mod+z",
    "redo": "mod+y",
    "copy": "mod+c",
    "cut": "mod+x",
    "paste": "mod+v",
    "paste_values_only": "mod+shift+v",
    "find": "mod+f",
    "find_and_replace": { "default": "ctrl+h", "darwin": "cmd+shift+h" },
    "fill_range": "mod+Return",
    "fill_down": "mod+d",
    "fill_right": "mod+r",
    "open_file": "mod+o",
    "print": "mod+p",
    "tool_finder": "alt+/",
    "show_shortcut_list": "mod+/",
    "toggle_compact_controls": "ctrl+shift+f",
    "insert_new_sheet": "shift+F11",
    "rename_sheet": { "win32": "alt+1", "linux": "alt+1", "darwin": "" },
    "convert_range_to_table": "mod+alt+t",
    "bold": "mod+b",
    "italic": "mod+i",
    "underline": "mod+u",
    "strikethrough": { "default": "alt+shift+5", "darwin": "cmd+shift+x" },
    "align_left": "mod+shift+l",
    "align_center": "mod+shift+e",
    "align_right": "mod+shift+r",
    "border_top": "alt+shift+1",
    "border_right": "alt+shift+2",
    "border_bottom": "alt+shift+3",
    "border_left": "alt+shift+4",
    "remove_borders": "alt+shift+6",
    "border_outer": "alt+shift+7",
    "insert_link": "mod+k",
    "insert_time": "mod+shift+;",
    "insert_date": "mod+;",
    "insert_date_and_time": "mod+alt+shift+;",
    "format_as_decimal": "ctrl+shift+1",
    "format_as_time": "ctrl+shift+2",
    "format_as_date": "ctrl+shift+3",
    "format_as_currency": "ctrl+shift+4",
    "format_as_percentage": "ctrl+shift+5",
    "format_as_exponent": "ctrl+shift+6",
    "clear_formatting": "mod+\\",
    "go_to_row_start": "Home",
    "go_to_row_end": "End",
    "go_to_sheet_start": "mod+Home",
    "go_to_sheet_end": "mod+End",
    "scroll_to_active_cell": "mod+Backspace",
    "next_sheet": "alt+Down",
    "previous_sheet": "alt+Up",
    "list_sheets": "alt+shift+k",
    "open_hyperlink": "alt+Return",
    "cycle_focus_areas_next": "mod+alt+.",
    "cycle_focus_areas_previous": "mod+alt+,",
    "focus_out_of_spreadsheet": { "default": "ctrl+alt+shift+m", "darwin": "ctrl+cmd+shift+m" },
    "go_to_quicksum": "alt+shift+q",
    "focus_popup": { "default": "ctrl+alt+e ctrl+alt+p", "darwin": "ctrl+cmd+e ctrl+cmd+p" },
    "open_filter_dropdown": { "default": "ctrl+alt+r", "darwin": "ctrl+cmd+r" },
    "open_version_history": "mod+alt+shift+h",
    "insert_or_edit_note": "shift+F2",
    "insert_or_edit_comment": "mod+alt+m",
    "open_comment_thread": "mod+alt+shift+a",
    "enter_current_comment": { "default": "ctrl+alt+e ctrl+alt+c", "darwin": "ctrl+cmd+e ctrl+cmd+c" },
    "next_comment": { "default": "ctrl+alt+n ctrl+alt+c", "darwin": "ctrl+cmd+n ctrl+cmd+c" },
    "previous_comment": { "default": "ctrl+alt+p ctrl+alt+c", "darwin": "ctrl+cmd+p ctrl+cmd+c" },
    "open_insert_menu": "mod+alt+=",
    "open_delete_menu": "mod+alt+-",
    "open_sheet_menu": "alt+shift+s",
    "open_context_menu": "mod+shift+\\",
    "open_table_column_menu": "mod+alt+\\",
    "insert_rows_below": { "default": "alt+i r b", "darwin": "ctrl+alt+i r b" },
    "insert_columns_right": { "default": "alt+i c o", "darwin": "ctrl+alt+i c o" },
    "hide_row": "mod+alt+9",
    "unhide_row": "mod+shift+9",
    "hide_column": "mod+alt+0",
    "unhide_column": "mod+shift+0",
    "group_rows_or_columns": "alt+shift+Right",
    "ungroup_rows_or_columns": "alt+shift+Left",
    "expand_group": "alt+shift+Down",
    "collapse_group": "alt+shift+Up",
    "insert_array_formula": "mod+shift+Return",
    "collapse_array_formula": "mod+e",
    "toggle_formula_help": "shift+F1",
    "toggle_formula_help_size": "F1",
    "toggle_absolute_reference": "F4",
    "toggle_formula_result_previews": "F9",
    "toggle_formula_range_selection": "F2",
    "resize_formula_bar_up": { "default": "ctrl+Up", "darwin": "ctrl+alt+Up" },
    "resize_formula_bar_down": { "default": "ctrl+Down", "darwin": "ctrl+alt+Down" }
  },
  "consequential": ["open_delete_menu"],
  "essentials": ["tool_finder", "go_to_sheet_start", "go_to_sheet_end", "next_sheet", "insert_new_sheet", "paste_values_only", "insert_rows_below", "find_and_replace"],
  "workflows": {
    "insert_row_above": {
      "name": "insert a row above the current row",
      "steps": [
        { "type": "pressKey", "key": "shift+Space", "note": "selects the whole row of the active cell" },
        { "type": "pressKey", "key": "mod+alt+=", "note": "with a row selected this inserts a row above" },
        { "type": "verify", "name": "row_inserted" }
      ]
    },
    "insert_column_left": {
      "name": "insert a column to the left of the current column",
      "steps": [
        { "type": "pressKey", "key": "ctrl+Space", "note": "selects the whole column of the active cell" },
        { "type": "pressKey", "key": "mod+alt+=", "note": "with a column selected this inserts a column to the left" },
        { "type": "verify", "name": "column_inserted" }
      ]
    },
    "delete_current_row": {
      "name": "delete the current row",
      "steps": [
        { "type": "pressKey", "key": "shift+Space", "note": "selects the whole row of the active cell" },
        { "type": "pressKey", "key": "mod+alt+-", "note": "with a row selected this deletes it" },
        { "type": "verify", "name": "row_deleted" }
      ]
    }
  },
  "tips": [
    "mod+alt+= and mod+alt+- depend on the selection: with cells selected they open the insert or delete menu; with whole rows or columns selected they insert above / to the left, or delete the selection, straight away.",
    "insert_rows_below and insert_columns_right go through the Insert menu. On Windows the Alt+i form is for Chrome; other browsers use Alt+Shift+i followed by the same letters.",
    "Menus on a Mac: Ctrl+Option+ f File, e Edit, v View, i Insert, o Format, d Data, t Tools, h Help. On Windows the same letters go with Alt in Chrome and Alt+Shift in other browsers.",
    "tool_finder (alt+/) searches the menus by command name; mod+/ lists every shortcut.",
    "The six number-format shortcuts use Ctrl on a Mac too, as do select_column (ctrl+Space) and toggle_compact_controls.",
    "F1, F4, F9 and F2 in this guide apply while a formula is being entered. redo can also be mod+shift+z or F4.",
    "rename_sheet (alt+1) is listed for Windows only. On a MacBook the sheet-switch keys are Option+Right and Option+Left instead of Option+Down and Option+Up.",
    "On keyboards for Portugal, Italy, Germany and Spain the date and time keys differ: Ctrl+Shift+d for date, Ctrl+Shift+h for time, Ctrl+Alt+Shift+n for both.",
    "Help > Keyboard shortcuts has a switch, \"Enable compatible spreadsheet shortcuts\", that turns on shortcuts used by other spreadsheet programs.",
    "Every change is saved to Drive on its own, so there is no save step. Some shortcuts might not work for all languages or keyboards."
  ],
  "sources": [
    "https://support.google.com/docs/answer/181110"
  ],
  "lastVerified": "2026-11-18"
}

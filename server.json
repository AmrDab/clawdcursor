{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AmrDab/clawdcursor",
  "description": "Safe cross-OS desktop control for any AI agent - the fallback execution layer.",
  "repository": {
    "url": "https://github.com/AmrDab/clawdcursor",
    "source": "github"
  },
  "version": "1.5.14",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "clawdcursor",
      "version": "1.5.14",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        { "type": "positional", "value": "mcp", "valueHint": "command" },
        { "type": "named", "name": "--compact" }
      ]
    }
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
